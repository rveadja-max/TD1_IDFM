# Copier ce fichier en .env puis renseigner les valeurs (ne jamais commiter .env).
# Les variables déjà définies dans l'environnement sont prioritaires sur .env.

# ID du projet GCP (l'ID, pas le nom), lié à un compte de facturation
GCP_PROJECT_ID=VOTRE_PROJECT_ID
# Localisation commune au bucket et aux datasets (non modifiable ensuite)
GCP_LOCATION=EU
# Nom de bucket unique au niveau mondial
GCS_BUCKET=VOTRE_BUCKET_UNIQUE
BQ_DATASET_SILVER=silver_idfm
BQ_DATASET_GOLD=gold_idfm
# Période : au moins trois années civiles complètes
START_YEAR=2023
END_YEAR=2025
# Date du snapshot Bronze ; la changer crée un nouveau snapshot
SNAPSHOT_DATE=2026-10-31
